      "name": "1. Actividades",
      "item": [
        {
          "name": "Listar con cupo disponible",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actividades"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Datos de la respuesta\", function () {",
                  "    const actividades = pm.response.json();",
                  "    pm.expect(actividades).to.have.lengthOf(8);",
                  "    pm.expect(actividades.find(actividad => actividad.nombre === \"Yoga\").cupoDisponible).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
